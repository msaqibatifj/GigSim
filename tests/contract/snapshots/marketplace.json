{
 "create_proposal_draft": {
  "ann": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "in": {
   "properties": {
    "bid_usd": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Bid Usd"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Idempotency key; same key = same effect, never repeated",
     "maxLength": 80,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 40,
     "minLength": 1,
     "pattern": "^[\\w-]+$",
     "title": "Job Id",
     "type": "string"
    },
    "text": {
     "maxLength": 5000,
     "minLength": 1,
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "job_id",
    "text",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "out": {
   "properties": {
    "connects_cost": {
     "title": "Connects Cost",
     "type": "integer"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Id"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "would_send": {
     "additionalProperties": true,
     "title": "Would Send",
     "type": "object"
    }
   },
   "required": [
    "ok",
    "dry_run",
    "would_send",
    "connects_cost"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
