---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	scout(scout)
	analyst(analyst)
	risk(risk)
	matcher(matcher)
	decide(decide)
	pricing(pricing)
	writer(writer)
	verifier(verifier)
	critic(critic)
	compliance(compliance)
	approval(approval)
	execute(execute)
	finish(finish)
	needs_attention(needs_attention)
	rejected(rejected)
	__end__([<p>__end__</p>]):::last
	__start__ --> scout;
	analyst --> decide;
	approval -.-> compliance;
	approval -.-> execute;
	approval -.-> rejected;
	compliance -.-> approval;
	compliance -.-> needs_attention;
	critic -.-> compliance;
	critic -.-> needs_attention;
	critic -.-> writer;
	decide -.-> finish;
	decide -.-> pricing;
	matcher --> decide;
	pricing -.-> finish;
	pricing -.-> writer;
	risk --> decide;
	scout -.-> analyst;
	scout -.-> matcher;
	scout -.-> risk;
	verifier --> critic;
	writer --> verifier;
	execute --> __end__;
	finish --> __end__;
	needs_attention --> __end__;
	rejected --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

