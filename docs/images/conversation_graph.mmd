---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	read(read)
	classify(classify)
	draft(draft)
	approval(approval)
	send(send)
	flag(flag)
	rejected(rejected)
	__end__([<p>__end__</p>]):::last
	__start__ --> read;
	approval -.-> rejected;
	approval -.-> send;
	classify -.-> draft;
	classify -.-> flag;
	draft --> approval;
	read --> classify;
	flag --> __end__;
	rejected --> __end__;
	send --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

